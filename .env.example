# نمونه‌ی تنظیمات محیطی. این فایل را به .env کپی کنید و مقدارها را پر کنید (.env هرگز commit نمی‌شود).
# رمزهای تصادفی قوی:  ./scripts/gen-secrets.sh

POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=admin@monikoshop.ir
ADMIN_PASSWORD=

# --- اختیاری ---
# دامنه‌ی اصلی سایت و API (برای sitemap و صفحات سئو). پیش‌فرض: APP_BASE_URL یا https://moniko.ir
# SITE_URL=https://moniko.ir
# API_PUBLIC_URL=https://api.moniko.ir
# بکاپ خودکار (docker compose --profile backup up -d db-backup)
# BACKUP_KEEP_DAYS=14
# BACKUP_INTERVAL_HOURS=24
